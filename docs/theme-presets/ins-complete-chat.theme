  "theme": {
    "globalCss": ":root {\n  --ins-sage-1: #c8d0bf;\n  --ins-sage-2: #aeb8a3;\n  --ins-cream: #f6f4ef;\n  --ins-cream-2: #efebe2;\n  --ins-blush: #f6edef;\n  --ins-pink: #e9aebb;\n  --ins-rose: #d88ea0;\n  --ins-brown: #5f5a5e;\n  --ins-line: rgba(126, 122, 126, 0.34);\n  --ins-shadow: 0 10px 28px rgba(48, 50, 46, 0.12);\n}\n\n.chat-bubble-theme-scope {\n  background:\n    radial-gradient(circle at top, rgba(255,255,255,0.16), transparent 28%),\n    linear-gradient(180deg, #aeb8a4 0%, #a3ad98 100%);\n}\n\n.chat-bubble-theme-scope::before {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(180deg, rgba(255,255,255,0.06), rgba(44,52,40,0.06));\n  pointer-events: none;\n}\n\n.chat-bubble-theme-scope > * {\n  position: relative;\n  z-index: 1;\n}\n\n.chat-bubble-theme-scope .chat-session-header {\n  min-height: 68px;\n  padding-bottom: 12px;\n  background: linear-gradient(180deg, rgba(223, 228, 215, 0.96), rgba(211, 217, 202, 0.92));\n  border-bottom: 1px solid rgba(116, 122, 109, 0.18);\n  backdrop-filter: blur(14px);\n  box-shadow: 0 6px 18px rgba(43, 48, 40, 0.08);\n}\n\n.chat-bubble-theme-scope .chat-header-back-button,\n.chat-bubble-theme-scope .chat-header-action-button,\n.chat-bubble-theme-scope .chat-header-avatar-button {\n  border-radius: 999px;\n  color: #2c2d2f;\n}\n\n.chat-bubble-theme-scope .chat-header-action-button,\n.chat-bubble-theme-scope .chat-header-back-button {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 34px;\n  height: 34px;\n  background: rgba(255,255,255,0.28);\n}\n\n.chat-bubble-theme-scope .chat-header-avatar {\n  width: 34px;\n  height: 34px;\n  border-radius: 14px;\n  border: 1px solid rgba(255,255,255,0.7);\n  box-shadow: 0 6px 12px rgba(45, 47, 42, 0.14);\n}\n\n.chat-bubble-theme-scope .chat-header-title {\n  color: #2f3132;\n  font-size: 18px;\n  font-weight: 800;\n  letter-spacing: 0.02em;\n}\n\n.chat-bubble-theme-scope .chat-header-subtitle {\n  color: rgba(66, 67, 70, 0.52);\n  font-size: 11px;\n}\n\n.chat-bubble-theme-scope .mb-3.flex.justify-center > .rounded-full.bg-white\\/72,\n.chat-bubble-theme-scope .mb-3.flex.justify-center > div.rounded-full {\n  background: rgba(248, 245, 241, 0.88);\n  color: #7b7679;\n  border: 1px solid rgba(151, 145, 148, 0.26);\n  box-shadow: 0 8px 18px rgba(35, 36, 38, 0.08);\n  backdrop-filter: blur(10px);\n}\n\n.chat-bubble-theme-scope .chat-bubble,\n.chat-bubble-theme-scope .message-bubble,\n.chat-bubble-theme-scope .chat-loading-bubble {\n  position: relative;\n  border-radius: 24px;\n  border: 2px solid #918a92;\n  box-shadow: 0 8px 20px rgba(43, 44, 48, 0.08);\n}\n\n.chat-bubble-theme-scope .chat-bubble::before,\n.chat-bubble-theme-scope .message-bubble::before,\n.chat-bubble-theme-scope .chat-loading-bubble::before {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  border-radius: inherit;\n  box-shadow: inset 0 1px 0 rgba(255,255,255,0.45);\n  pointer-events: none;\n}\n\n.chat-bubble-theme-scope .bot-bubble,\n.chat-bubble-theme-scope .chat-bubble-left,\n.chat-bubble-theme-scope .chat-loading-bubble {\n  background: rgba(246, 238, 241, 0.96);\n  color: var(--ins-brown);\n}\n\n.chat-bubble-theme-scope .user-bubble,\n.chat-bubble-theme-scope .chat-bubble-right {\n  background: rgba(252, 250, 251, 0.98);\n  color: #5b565b;\n}\n\n.chat-bubble-theme-scope .chat-bubble-left::after {\n  content: \"\";\n  position: absolute;\n  left: -8px;\n  bottom: 12px;\n  width: 16px;\n  height: 16px;\n  background: inherit;\n  border-left: 2px solid #918a92;\n  border-bottom: 2px solid #918a92;\n  transform: rotate(45deg);\n  border-bottom-left-radius: 4px;\n}\n\n.chat-bubble-theme-scope .chat-bubble-right::after {\n  content: \"\";\n  position: absolute;\n  right: -8px;\n  bottom: 12px;\n  width: 16px;\n  height: 16px;\n  background: inherit;\n  border-right: 2px solid #918a92;\n  border-bottom: 2px solid #918a92;\n  transform: rotate(-45deg);\n  border-bottom-right-radius: 4px;\n}\n\n.chat-bubble-theme-scope .corner {\n  display: block;\n  width: 10px;\n  height: 10px;\n  border-radius: 999px;\n  background: #a19aa3;\n  opacity: 0.78;\n}\n\n.chat-bubble-theme-scope .corner.tl {\n  left: -5px;\n  top: -5px;\n}\n\n.chat-bubble-theme-scope .corner.tr {\n  right: -5px;\n  top: -5px;\n}\n\n.chat-bubble-theme-scope .corner.bl {\n  left: 14px;\n  bottom: -5px;\n}\n\n.chat-bubble-theme-scope .corner.br {\n  right: 30px;\n  bottom: -5px;\n}\n\n.chat-bubble-theme-scope .sticker-skull {\n  width: 28px;\n  height: 28px;\n  right: -10px;\n  bottom: -7px;\n  border-radius: 999px;\n  border: 2px solid #908992;\n  background: rgba(255,255,255,0.96);\n  box-shadow: 0 4px 10px rgba(43, 45, 48, 0.12);\n}\n\n.chat-bubble-theme-scope .chat-reply-preview,\n.chat-bubble-theme-scope .chat-footer-reply-preview {\n  border-radius: 18px;\n  border: 1px solid rgba(151, 145, 148, 0.26);\n  background: rgba(248, 245, 241, 0.88);\n  box-shadow: 0 6px 14px rgba(35, 36, 39, 0.08);\n  color: #6b656b;\n}\n\n.chat-bubble-theme-scope .text-\\[10px\\].text-zinc-400 {\n  color: rgba(244, 238, 242, 0.58) !important;\n  text-shadow: 0 1px 1px rgba(66, 68, 62, 0.08);\n}\n\n.chat-bubble-theme-scope .chat-message-image,\n.chat-bubble-theme-scope .chat-location-card,\n.chat-bubble-theme-scope .chat-transfer-card,\n.chat-bubble-theme-scope .chat-notice-card,\n.chat-bubble-theme-scope .chat-inner-voice-card {\n  border-radius: 22px;\n  border: 1px solid rgba(151, 145, 148, 0.28);\n  box-shadow: 0 10px 22px rgba(36, 37, 41, 0.1);\n  overflow: hidden;\n}\n\n.chat-bubble-theme-scope .chat-session-footer {\n  padding-top: 10px;\n  padding-bottom: calc(10px + var(--app-safe-area-bottom-ui, 0px));\n  background: linear-gradient(180deg, rgba(201, 207, 186, 0.82), rgba(188, 195, 171, 0.96));\n  border-top: 1px solid rgba(117, 123, 101, 0.22);\n  backdrop-filter: blur(18px);\n}\n\n.chat-bubble-theme-scope .chat-footer-controls {\n  gap: 8px;\n}\n\n.chat-bubble-theme-scope .chat-footer-input-shell,\n.chat-bubble-theme-scope .chat-footer-action-input-shell {\n  border-radius: 999px;\n  border: 1px solid rgba(143, 145, 125, 0.34);\n  background: rgba(247, 246, 238, 0.96);\n  box-shadow: inset 0 1px 0 rgba(255,255,255,0.76);\n}\n\n.chat-bubble-theme-scope .chat-footer-action-input-shell {\n  border-radius: 22px;\n}\n\n.chat-bubble-theme-scope .chat-footer-textarea,\n.chat-bubble-theme-scope .chat-footer-action-textarea {\n  color: #66605f;\n}\n\n.chat-bubble-theme-scope .chat-footer-textarea::placeholder,\n.chat-bubble-theme-scope .chat-footer-action-textarea::placeholder {\n  color: rgba(102, 96, 95, 0.56);\n}\n\n.chat-bubble-theme-scope .chat-footer-voice-toggle-button,\n.chat-bubble-theme-scope .chat-footer-manual-reply-button,\n.chat-bubble-theme-scope .chat-footer-plus-button,\n.chat-bubble-theme-scope .chat-footer-emoji-button,\n.chat-bubble-theme-scope .chat-footer-expand-button {\n  color: #383b38;\n}\n\n.chat-bubble-theme-scope .chat-footer-voice-toggle-button,\n.chat-bubble-theme-scope .chat-footer-manual-reply-button,\n.chat-bubble-theme-scope .chat-footer-plus-button {\n  width: 38px;\n  height: 38px;\n  border-radius: 999px;\n  border: 1px solid rgba(142, 145, 122, 0.28);\n  background: rgba(246, 244, 236, 0.96);\n  box-shadow: 0 6px 14px rgba(43, 45, 43, 0.1);\n}\n\n.chat-bubble-theme-scope .chat-footer-send-button {\n  width: 38px;\n  height: 38px;\n  border-radius: 999px;\n  border: 1px solid rgba(214, 154, 171, 0.4);\n  background: linear-gradient(180deg, #f0bcc7, #df98aa);\n  color: white;\n  box-shadow: 0 8px 16px rgba(205, 131, 151, 0.28);\n}\n\n.chat-bubble-theme-scope .chat-footer-voice-button {\n  border-radius: 999px;\n  border: 1px solid rgba(142, 145, 122, 0.28);\n  background: rgba(246, 244, 236, 0.96);\n  color: #4b4c4c;\n  box-shadow: 0 6px 14px rgba(43, 45, 43, 0.08);\n}\n\n.chat-bubble-theme-scope .chat-footer-action-toggle-button {\n  background: rgba(233, 227, 218, 0.86);\n  color: #6e6768;\n}\n\n.chat-bubble-theme-scope .chat-footer-panel {\n  margin-top: 10px;\n  border-radius: 24px;\n  border: 1px solid rgba(143, 145, 125, 0.24);\n  background: rgba(249, 247, 241, 0.7);\n  backdrop-filter: blur(14px);\n  padding: 0 12px 12px;\n}\n\n.chat-bubble-theme-scope .chat-footer-sticker-tabs {\n  gap: 8px;\n  border-bottom: 0;\n}\n\n.chat-bubble-theme-scope .chat-footer-sticker-tab-button {\n  border-radius: 999px;\n  background: rgba(236, 231, 222, 0.7);\n}\n\n.chat-bubble-theme-scope .chat-footer-emoji-grid-button,\n.chat-bubble-theme-scope .chat-footer-custom-sticker-button {\n  border-radius: 16px;\n  background: rgba(255,255,255,0.5);\n  border: 1px solid rgba(149, 143, 146, 0.16);\n}\n\n.chat-bubble-theme-scope .chat-footer-fun-action {\n  gap: 8px;\n}\n\n.chat-bubble-theme-scope .chat-footer-fun-action-icon {\n  border-radius: 20px;\n  border: 1px solid rgba(151, 145, 148, 0.22);\n  background: linear-gradient(180deg, rgba(250,248,244,0.98), rgba(240,236,228,0.94));\n  box-shadow: 0 8px 18px rgba(43, 45, 48, 0.08);\n}\n\n.chat-bubble-theme-scope .chat-footer-fun-action span {\n  color: #6d666c;\n  font-weight: 600;\n}\n",
