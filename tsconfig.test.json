{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./test-dist",
    "rootDir": ".",
    "allowImportingTsExtensions": false,
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "isolatedModules": false,
    "sourceMap": false
  },
  "include": [
    "src/**/*.test.ts"
  ]
}
