{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "build:pages": "vite build",
    "preview": "vite preview",
    "test": "tsc -p tsconfig.test.json && node -e \"require('fs').mkdirSync('test-dist',{recursive:true});require('fs').writeFileSync('test-dist/package.json', JSON.stringify({ type: 'commonjs' }))\" && node --test --test-isolation=none --test-concurrency=1 test-dist/src/**/*.test.js",
    "audit:legacy-character-fields": "node scripts/audit-legacy-character-fields.mjs",
    "cf:deploy:pages": "npm run build:pages && wrangler pages deploy dist --project-name bloom-pages",
    "cf:dev:pages": "npm run build:pages && wrangler pages dev dist",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.0",
    "motion": "^12.23.24",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-easy-crop": "^5.5.6",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-legacy": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wrangler": "^4.14.4"
  }
}
